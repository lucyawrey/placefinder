namespace place

enum Sky {
  Atmosphere
  Gradient
  None
}

class Portal(
  target: String
  center: (Float, Float, Float)
  size: (Float, Float, Float)
  name: String? = None
  yaw: Float = 0.0
  label: String? = None
  show_label: Bool = true
)

class Spawn(center: (Float, Float, Float), yaw: Float = 0.0)

class Label(text: String, center: (Float, Float, Float), yaw: Float = 0.0, height: Float = 0.25)

class Place {
  let version: String
  let name: String
  let scene: String? = None
  let spawn: Spawn? = None
  let ui: String? = None
  let portals: Portal[] = []
  let labels: Label[] = []
  let capture_mouse: Bool = false
  let sky: Sky = Sky.Atmosphere
}
