namespace place

enum Sky {
  Atmosphere
  Gradient
  None
}

class Portal(target: String, center: (Float, Float, Float), size: (Float, Float, Float))

class Place {
  let version: Int
  let name: String
  let scene: String
  let spawn: (Float, Float, Float)
  let portals: Portal[] = []
  let capture_mouse: Bool = false
  let sky: Sky = Sky.Atmosphere
}
